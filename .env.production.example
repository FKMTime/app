# Public origin of the app (used by NextAuth for callback URLs).
NEXTAUTH_URL=https://fkmtime.example.com
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Domain Caddy will obtain a TLS cert for; email for Let's Encrypt notices.
DOMAIN=fkmtime.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Postgres credentials (used by both the database and app containers).
POSTGRES_USER=fkmtime
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fkmtime

# WCA OAuth app credentials.
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=
# Override only when pointing at the staging WCA instance:
# WCA_ORIGIN=https://staging.worldcubeassociation.org

# Symmetric key used to encrypt proxy secrets and pending one-time API keys
# at rest. >= 32 chars. Rotating this fails-loud (old ciphertexts become
# unreadable) — plan migrations accordingly.
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Shared secret for the API-key expiry cron endpoint. Hit
# `POST /api/cron/expire-keys` with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me

# fkm-proxy integration. In production both must be set; for local dev set
# FKM_PROXY_DEV_FAKE=true to get a stub that returns dummy URL+secret.
# FKM_PROXY_URL=https://proxy.fkmtime.example.com
# FKM_PROXY_API_TOKEN=
# FKM_PROXY_DEV_FAKE=true

# API keys auto-expire `competition end + this many days`. Default 7.
# API_KEY_TTL_DAYS=7
