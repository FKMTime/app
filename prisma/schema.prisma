generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  wcaUserId     Int?      @unique @map("wca_user_id")
  wcaId         String?   @unique @map("wca_id")
  isAdmin       Boolean   @default(false) @map("is_admin")
  accounts      Account[]
  sessions      Session[]

  requestedCompetitions Competition[]      @relation("RequestedBy")
  approvedCompetitions  Competition[]      @relation("ApprovedBy")
  competitionRoles      CompetitionRole[]
  editedAttempts        Attempt[]          @relation("AttemptEditedBy")
  createdIncidents      Incident[]         @relation("IncidentCreatedBy")
  pushSubscriptions     PushSubscription[]
  notificationLogs      NotificationLog[]

  @@map("users")
}

enum CompetitionStatus {
  REQUESTED
  REJECTED
  APPROVED
  LIVE
  FINISHED
}

enum CompetitionRoleKind {
  ORGANIZER
  DELEGATE
}

enum CompetitionRoleSource {
  WCA
  MANUAL
}

model Competition {
  id                 String            @id @default(cuid())
  wcaId              String            @unique @map("wca_id")
  name               String
  shortName          String?           @map("short_name")
  startDate          DateTime          @map("start_date")
  endDate            DateTime          @map("end_date")
  status             CompetitionStatus @default(REQUESTED)
  requestNotes       String?           @map("request_notes")
  rejectionReason    String?           @map("rejection_reason")

  // Proxy tunnel: URL is public-ish (the public hostname the instance is
  // reachable at); the secret is the per-tunnel password and is encrypted at
  // rest. Both are populated on approval (via the fkm-proxy create call).
  proxyTunnelUrl     String?           @map("proxy_tunnel_url")
  proxySecretEnc     String?           @map("proxy_secret_enc")

  // Transient one-time-reveal payload for the latest generated API key:
  // encrypted plaintext + expiry. Both fields are cleared the first time
  // either the requester or an admin reveals the key.
  pendingApiKeyEnc       String?  @map("pending_api_key_enc")
  pendingApiKeyExpiresAt DateTime? @map("pending_api_key_expires_at")

  requestedById      String            @map("requested_by_id")
  requestedBy        User              @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById       String?           @map("approved_by_id")
  approvedBy         User?             @relation("ApprovedBy", fields: [approvedById], references: [id])

  requestedAt        DateTime          @default(now()) @map("requested_at")
  approvedAt         DateTime?         @map("approved_at")
  rejectedAt         DateTime?         @map("rejected_at")

  apiKeys            ApiKey[]
  roles              CompetitionRole[]
  persons            Person[]
  groups             Group[]
  assignments        Assignment[]
  results            Result[]
  attempts           Attempt[]
  incidents          Incident[]
  syncStatus         SyncStatus?
  pushOptIns         PushCompetitionOptIn[]
  notificationLogs   NotificationLog[]
  dumps              DbDump[]

  @@index([status])
  @@map("competitions")
}

model ApiKey {
  id            String       @id @default(cuid())
  competitionId String       @map("competition_id")
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // SHA-256 hex of the plaintext key; plaintext is shown to the user once on
  // creation and never stored.
  keyHash       String       @unique @map("key_hash")
  // Last 4 chars of the plaintext, kept so the admin UI can identify a key
  // without revealing it.
  lastFour      String       @map("last_four")
  createdAt     DateTime     @default(now()) @map("created_at")
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  lastUsedAt    DateTime?    @map("last_used_at")

  @@index([competitionId])
  @@map("api_keys")
}

model CompetitionRole {
  id            String                 @id @default(cuid())
  userId        String                 @map("user_id")
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String                 @map("competition_id")
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  role          CompetitionRoleKind
  source        CompetitionRoleSource  @default(WCA)
  createdAt     DateTime               @default(now()) @map("created_at")

  @@unique([userId, competitionId, role])
  @@index([competitionId])
  @@map("competition_roles")
}

// =====================================================================
// Phase 2 — synced from FKMTime instances.
//
// Every row carries:
//   - competitionId : which comp it belongs to (derived from the API key)
//   - instanceId    : stable FKMTime-instance identifier; (competitionId,
//                     instanceId) is unique, so upserts are O(1) and
//                     foreign keys between entities resolve by instanceId.
//   - sourceUpdatedAt : the instance's own updatedAt for the row, used to
//                     reject stale out-of-order deltas.
// =====================================================================

enum GroupStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum AssignmentRole {
  COMPETITOR
  JUDGE
  RUNNER
  SCRAMBLER
}

enum AttemptType {
  STANDARD
  EXTRA
}

enum AttemptStatus {
  STANDARD
  EXTRA
  DNF
  DNS
}

enum IncidentKind {
  NOTEWORTHY
  MANUAL
  WARNING
}

enum IncidentSource {
  SYNC
  MANUAL
}

model Person {
  id              String       @id @default(cuid())
  competitionId   String       @map("competition_id")
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String       @map("instance_id")
  registrantId    Int          @map("registrant_id")
  name            String
  wcaUserId       Int?         @map("wca_user_id")
  wcaId           String?      @map("wca_id")
  countryIso2     String?      @map("country_iso2")
  gender          String?
  sourceUpdatedAt DateTime     @map("source_updated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  assignments     Assignment[]
  results         Result[]
  incidents       Incident[]

  @@unique([competitionId, instanceId])
  @@index([competitionId, wcaUserId])
  @@map("persons")
}

model Group {
  id              String       @id @default(cuid())
  competitionId   String       @map("competition_id")
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String       @map("instance_id")
  activityCode    String       @map("activity_code")
  name            String
  roomName        String?      @map("room_name")
  roomColor       String?      @map("room_color")
  status          GroupStatus  @default(UPCOMING)
  startTime       DateTime?    @map("start_time")
  endTime         DateTime?    @map("end_time")
  sourceUpdatedAt DateTime     @map("source_updated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  assignments      Assignment[]
  notificationLogs NotificationLog[]

  @@unique([competitionId, instanceId])
  @@index([competitionId, activityCode])
  @@map("groups")
}

model Assignment {
  id              String         @id @default(cuid())
  competitionId   String         @map("competition_id")
  competition     Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String         @map("instance_id")
  personId        String         @map("person_id")
  person          Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  groupId         String         @map("group_id")
  group           Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role            AssignmentRole
  sourceUpdatedAt DateTime       @map("source_updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([competitionId, instanceId])
  @@index([competitionId, personId])
  @@index([competitionId, groupId])
  @@map("assignments")
}

model Result {
  id              String       @id @default(cuid())
  competitionId   String       @map("competition_id")
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String       @map("instance_id")
  personId        String       @map("person_id")
  person          Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  eventId         String       @map("event_id")
  roundId         String       @map("round_id")
  sourceUpdatedAt DateTime     @map("source_updated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  attempts        Attempt[]

  @@unique([competitionId, instanceId])
  @@index([competitionId, roundId])
  @@map("results")
}

model Attempt {
  id              String         @id @default(cuid())
  competitionId   String         @map("competition_id")
  competition     Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String         @map("instance_id")
  resultId        String         @map("result_id")
  result          Result         @relation(fields: [resultId], references: [id], onDelete: Cascade)
  attemptNumber   Int            @map("attempt_number")
  value           Int
  penalty         Int            @default(0)
  type            AttemptType    @default(STANDARD)
  // attemptNumber of the standard attempt this extra replaces (if any).
  replacedBy      Int?           @map("replaced_by")
  status          AttemptStatus  @default(STANDARD)
  // Delegate/admin-only: extra reasons + free-form notes. NEVER exposed in
  // public/competitor payloads — enforced via per-role Prisma selects.
  description     String?
  editedById      String?        @map("edited_by_id")
  editedBy        User?          @relation("AttemptEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt        DateTime?      @map("edited_at")
  sourceUpdatedAt DateTime       @map("source_updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  incidents       Incident[]

  @@unique([competitionId, instanceId])
  @@index([resultId])
  @@map("attempts")
}

model Incident {
  id              String         @id @default(cuid())
  competitionId   String         @map("competition_id")
  competition     Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  instanceId      String         @map("instance_id")
  source          IncidentSource @default(SYNC)
  kind            IncidentKind
  description     String
  personId        String?        @map("person_id")
  person          Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  attemptId       String?        @map("attempt_id")
  attempt         Attempt?       @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdById     String?        @map("created_by_id")
  createdBy       User?          @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sourceUpdatedAt DateTime       @map("source_updated_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([competitionId, instanceId])
  @@index([competitionId])
  @@map("incidents")
}

model SyncStatus {
  competitionId    String      @id @map("competition_id")
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  lastHeartbeatAt  DateTime?   @map("last_heartbeat_at")
  lastDeltaAt      DateTime?   @map("last_delta_at")
  instanceVersion  String?     @map("instance_version")
  lastClientSentAt DateTime?   @map("last_client_sent_at")

  @@map("sync_status")
}

// =====================================================================
// Phase 5 — Web Push notifications.
//
// A subscription is tied to a User; per-competition opt-in is expressed
// via the join table PushCompetitionOptIn. A user can subscribe on
// multiple devices — each device (endpoint) is one row.
// =====================================================================

model PushSubscription {
  id            String                  @id @default(cuid())
  userId        String                  @map("user_id")
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String                  @unique
  p256dh        String
  authKey       String                  @map("auth_key")
  userAgent     String?                 @map("user_agent")
  createdAt     DateTime                @default(now()) @map("created_at")
  lastUsedAt    DateTime?               @map("last_used_at")

  competitions  PushCompetitionOptIn[]

  @@index([userId])
  @@map("push_subscriptions")
}

model PushCompetitionOptIn {
  subscriptionId String            @map("subscription_id")
  subscription   PushSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  competitionId  String            @map("competition_id")
  competition    Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@id([subscriptionId, competitionId])
  @@index([competitionId])
  @@map("push_competition_optins")
}

enum NotificationKind {
  GROUP_ONGOING
}

// Dedupe log: unique (groupId, userId, kind). A heartbeat re-asserting an
// already-notified group status can never send a duplicate push.
model NotificationLog {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String            @map("competition_id")
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  groupId       String            @map("group_id")
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind          NotificationKind
  sentAt        DateTime          @default(now()) @map("sent_at")

  @@unique([groupId, userId, kind])
  @@index([competitionId])
  @@map("notification_logs")
}

// =====================================================================
// Phase 6 — End-of-competition dumps.
// =====================================================================

model DbDump {
  id            String       @id @default(cuid())
  competitionId String       @map("competition_id")
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // R2 object key (e.g. "dumps/<wcaId>/<uploadedAt>.sql.gz").
  objectKey     String       @map("object_key")
  sizeBytes     BigInt       @map("size_bytes")
  uploadedAt    DateTime     @default(now()) @map("uploaded_at")

  @@index([competitionId])
  @@map("db_dumps")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}